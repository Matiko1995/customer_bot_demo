{
  "name": "customer-bot2",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run app:dev",
    "build": "npm run app:widget:build && npm run app:build",
    "preview": "npm run app:preview",
    "app:dev": "node -r ./scripts/preload-windows-build.cjs ./node_modules/nuxt/bin/nuxt.mjs dev --no-fork --host 127.0.0.1 --port 3203",
    "app:build": "node -r ./scripts/preload-windows-build.cjs ./node_modules/nuxt/bin/nuxt.mjs build",
    "app:preview": "cmd /c \"set HOST=127.0.0.1&& set PORT=3202&& node .output\\server\\index.mjs\"",
    "app:widget:build": "tsup && node scripts/write-widget-version.mjs",
    "app:bundle": "npm run build && node scripts/archive-build-output.mjs",
    "db:migrate": "node --import tsx server/lib/db/run-migrations.ts",
    "data:import:fastener": "node --experimental-strip-types scripts/import-fastener-training-pack.ts",
    "service:tenant-identity": "node --experimental-strip-types services\\tenant-identity-service\\src\\server.ts",
    "service:knowledge-indexing": "node --experimental-strip-types services\\knowledge-indexing-service\\src\\server.ts",
    "service:agent-runtime": "node --experimental-strip-types services\\agent-runtime-service\\src\\server.ts",
    "service:embed-delivery": "node --experimental-strip-types services\\embed-delivery-service\\src\\server.ts",
    "stack:dev": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-local-stack.ps1",
    "stack:dry-run": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-local-stack.ps1 -DryRun",
    "test": "vitest run",
    "verify:agent-docs": "node --experimental-strip-types scripts/verify-agent-docs.ts",
    "verify:chat": "node --experimental-strip-types scripts/verify-chat-routing.ts",
    "verify:chat-persistence": "node --experimental-strip-types scripts/verify-chat-persistence.ts",
    "verify:embed-delivery-standalone": "node --experimental-strip-types scripts/verify-embed-delivery-standalone-http.ts",
    "verify:fastener-import": "node --experimental-strip-types scripts/verify-fastener-import.ts",
    "verify:fastener-pack": "node --experimental-strip-types scripts/verify-fastener-training-pack.ts",
    "verify:index-health": "node --experimental-strip-types scripts/verify-index-health.ts",
    "verify:ingestion": "node --experimental-strip-types scripts/verify-ingestion.ts",
    "verify:postgres-rag": "node --experimental-strip-types scripts/verify-postgres-rag-repository.ts",
    "verify:pm2-ecosystem": "node --experimental-strip-types scripts/verify-pm2-ecosystem.ts",
    "verify:rag-settings": "node --experimental-strip-types scripts/verify-rag-settings.ts",
    "verify:release-pipeline": "node --experimental-strip-types scripts/verify-release-pipeline.ts",
    "verify:remote-gateways": "node --experimental-strip-types scripts/verify-remote-gateways.ts",
    "verify:remote-stack": "node --experimental-strip-types scripts/verify-remote-stack-http.ts",
    "verify:service-skeleton": "node --experimental-strip-types scripts/verify-service-skeleton.ts",
    "verify:source-config": "node --experimental-strip-types scripts/verify-source-config.ts",
    "verify:stack-launcher": "node --experimental-strip-types scripts/verify-stack-launcher.ts",
    "verify:tenant-identity-standalone": "node --experimental-strip-types scripts/verify-tenant-identity-standalone-http.ts",
    "verify:knowledge-indexing-standalone": "node --experimental-strip-types scripts/verify-knowledge-indexing-standalone-http.ts",
    "verify:agent-runtime-standalone": "node --experimental-strip-types scripts/verify-agent-runtime-standalone-http.ts",
    "verify:types": "node .\\node_modules\\typescript\\bin\\tsc --noEmit",
    "services:list": "node --experimental-strip-types scripts/list-service-packages.ts",
    "deploy:pm2:start": "pm2 start deploy/pm2/ecosystem.config.cjs",
    "deploy:pm2:reload": "pm2 reload deploy/pm2/ecosystem.config.cjs",
    "deploy:pm2:logs": "pm2 logs",
    "package:current": "bash scripts/package-current.sh",
    "release:current": "bash scripts/release-current.sh",
    "deploy:current": "bash scripts/deploy-current.sh"
  },
  "dependencies": {
    "imapflow": "^1.1.1",
    "mammoth": "^1.10.0",
    "nuxt": "^4.1.2",
    "pg": "^8.16.3",
    "pgvector": "^0.2.1",
    "xlsx": "^0.18.5",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
